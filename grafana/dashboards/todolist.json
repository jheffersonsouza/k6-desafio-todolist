      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "k6influx"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT percentile(\"value\", 95) AS \"95% em até\", percentile(\"value\", 50) AS \"normal\" FROM \"http_req_duration\" WHERE \"fase\" = 'teste' AND \"api\" =~ /^$api$/ AND \"rotulo\" =~ /^$execucao$/ AND $timeFilter GROUP BY time($__interval), \"run\", \"rotulo\" fill(none)",
          "alias": "$col · $tag_rotulo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 500
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^95%.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^normal.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "datasource": {
        "type": "influxdb",
        "uid": "k6influx"

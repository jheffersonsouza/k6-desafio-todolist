# Copie para .env e ajuste. O docker compose lê o .env sozinho.

# Nome que aparece nos relatórios (java, csharp...).
API=java

# Endereço da sua API visto de dentro do container: troque só a porta.
BASE_URL=http://host.docker.internal:8080

# Opcionais. Vazio usa o padrão; o README explica cada um.
RATE=
DURATION=
SCENARIOS=
USERS=
AUTH_SCHEME=
SKIP_CONTRACT=
